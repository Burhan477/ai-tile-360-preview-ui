# Copy to .env.local and fill in. Never commit real values.

# Supabase Dashboard → Project Settings → Data API → Project URL
# (a trailing /rest/v1/ is accepted and ignored).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard → Project Settings → API Keys → Publishable key
# (sb_publishable_…). Public by design: it can only read the catalog (RLS).
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Dashboard → Project Settings → API Keys → Secret key (sb_secret_…).
# SERVER-ONLY: bypasses RLS. Used by the upload/image Route Handlers to write
# to Storage and sign URLs. Never prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SECRET_KEY=

# Optional. Largest image POST /api/uploads accepts, in bytes (default 4194304
# = 4 MiB, max 10485760). Vercel rejects request bodies over 4.5 MB anyway.
# UPLOAD_MAX_BYTES=4194304

# Optional. Lifetime of signed URLs for private images, in seconds
# (default 3600, min 60, max 604800).
# SIGNED_URL_TTL_SECONDS=3600

# --- AI room generation (M5-A, Gemini) -------------------------------------
# aistudio.google.com → Get API key. SERVER-ONLY: never prefix with NEXT_PUBLIC_
# (the app refuses to run generation if NEXT_PUBLIC_GEMINI_API_KEY is set).
# Gemini image models have no free tier: the key's project needs billing.
GEMINI_API_KEY=

# Required. Gemini image model id, without the models/ prefix. Check the
# current list at ai.google.dev/gemini-api/docs/image-generation, e.g.
# gemini-3.1-flash-image or gemini-3-pro-image (gemini-2.5-flash-image is legacy).
GEMINI_IMAGE_MODEL=

# Optional. 21:9 (default) or 16:9. Output is an ordinary wide photo, never a
# 2:1 equirectangular panorama.
# GEMINI_IMAGE_ASPECT_RATIO=21:9

# Optional. 1K | 2K | 4K. Unset = model default (1K); older models such as
# gemini-2.5-flash-image reject it. 4K PNGs can exceed the 10 MiB bucket limit.
# GEMINI_IMAGE_SIZE=2K

# Optional spend guards for the anonymous endpoint: jobs running at once
# (default 2) and jobs created per rolling 24 h (default 25).
# GENERATION_MAX_ACTIVE=2
# GENERATION_DAILY_LIMIT=25

HF_TOKEN=
HF_IMAGE_MODEL=